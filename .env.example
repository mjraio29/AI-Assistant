# Copy this file to .env and fill in your key. Never commit .env.
# Get a free Groq API key (no credit card required) at:
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Optional overrides -- defaults shown
ASSISTANT_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
ASSISTANT_MAX_TOKENS=1024
MAX_HISTORY_MESSAGES=20
MAX_TOOL_ITERATIONS=5

ASSISTANT_DB_PATH=./assistant.db

RAG_ENABLED=false
RAG_COLLECTION_DIR=./rag_store
RAG_TOP_K=4

API_HOST=0.0.0.0
API_PORT=8000
